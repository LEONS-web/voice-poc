# ===== 服务端口 =====
PORT=8787

# ===== 模拟模式：还没有 API 密钥时设为 1，可先跑通全链路（STT/LLM 返回模拟数据，TTS 跳过）=====
MOCK_AI=0

# ===== LLM（OpenAI 兼容协议：DeepSeek / OpenAI / Moonshot / 任意兼容服务）=====
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_SYSTEM_PROMPT=你是一个友好的语音陪聊助手，请用简短、口语化的一两句话回答用户。

# ===== Whisper STT（OpenAI 兼容接口：Groq 免费档 / OpenAI 官方 / 自部署）=====
WHISPER_BASE_URL=https://api.groq.com/openai/v1
WHISPER_API_KEY=
WHISPER_MODEL=whisper-large-v3

# ===== ElevenLabs 流式 TTS（任务 C 加分项，可选）=====
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
